# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Trained model artifacts — large binaries, rebuilt from the recipe:
# notebooks/train_random_forest.ipynb + frozen train.csv + models/rf_metrics.json
models/*.joblib

# Jupyter checkpoints
.ipynb_checkpoints/

# IDE
.idea/

# Component sources build to components/*/build, and those builds ARE
# committed: Streamlit Community Cloud installs Python requirements only and
# never runs npm, so an uncommitted build means a blank page on deploy.
node_modules/
components/*/.vite/

# SHAP batch checkpoints — intermediate state, superseded by
# reports/shap/shap_values_encoded.npy once the run completes
reports/shap/chunks/
reports/shap/batch.log
